# mac-access.sh 本地配置示例
# 复制为 config.local.env（同目录，已在 .gitignore），按你的链路填写真实值。
# 也可用环境变量传入，或用 MAC_ACCESS_CONF 指向别的文件。

# 必填：Windows 的 SSH 目标（Mac -> Windows 免密 SSH）
MAC_DSH_WIN_HOST='winuser@192.0.2.10'

# 必填：Windows 侧一键脚本目录（无反斜杠结尾）
MAC_DSH_WIN_TOOLS_DIR='C:\tools\mac-dsh'

# 必填：Windows 侧登录 URL 文件（Mac 推送目标）
MAC_DSH_WIN_URL_FILE='C:\Users\winuser\.dsh\mac-dsh-url.txt'

# 必填：Mac DSH GUI 的局域网地址（DSH 拒绝 0.0.0.0，只能绑具体接口 IP）
MAC_DSH_LAN_BASE='http://192.0.2.20:3080'

# 可选：Mac DSH 标准输出日志（登录 URL 在这里）
MAC_DSH_LOG="$HOME/Library/Logs/dsh-web.out.log"

# 可选：URL 推送 LaunchAgent 的 label 与本地日志
MAC_DSH_LAUNCHD_LABEL='com.user.dsh-url-push'
MAC_DSH_PUSH_LOG='/tmp/dsh-url-push.log'

# 可选：Windows 桌面快捷方式名称
MAC_DSH_LNK_NAME='Mac DSH.lnk'
